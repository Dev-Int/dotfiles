# ─── .zsh_aliases — Aliases communs (perso + pro) ────────────────────────────

# ─── Système ──────────────────────────────────────────────────────────────────
alias ll='ls -alFh --color=auto'
alias la='ls -A'
alias ..='cd ..'
alias ...='cd ../..'
alias grep='grep --color=auto'
alias df='df -h'
alias du='du -sh'

# ─── Ubuntu update (apt + snap + nettoyage snap) ──────────────────────────────
_remove_old_snaps() {
  LANG=C snap list --all 2>/dev/null | awk '/disabled/{print $1, $3}' | \
    while read -r snapname revision; do
      sudo snap remove "$snapname" --revision="$revision"
    done
}
alias ubuntu_update='sudo apt autoremove && sudo apt update && sudo apt dist-upgrade -y \
  && sudo apt autoremove -y && sudo apt autoclean \
  && sudo snap refresh && _remove_old_snaps'

# ─── Utilitaires ──────────────────────────────────────────────────────────────
# Vérifie un checksum sha256 : sha256 <hash_attendu> <fichier>
sha256() {
  printf '%s %s\n' "$1" "$2" | sha256sum --check
}

# ─── Dotfiles ─────────────────────────────────────────────────────────────────
alias dotfiles='cd ~/.dotfiles'
alias dotcap='~/.dotfiles/scripts/capture.sh'
